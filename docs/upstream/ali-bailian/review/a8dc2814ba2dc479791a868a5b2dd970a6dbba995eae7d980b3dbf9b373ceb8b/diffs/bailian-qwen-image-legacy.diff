-    # 创建异步任务
-    def create_async_task():
-        rsp = ImageSynthesis.async_call(api_key=api_key,
-                                        model="qwen-image-3.0-pro",
-                                        prompt=prompt,
-                                        negative_prompt=" ",
-                                        n=1,
-                                        size='1664*928',
-                                        prompt_extend=True,
-                                        watermark=False)
-        print(rsp)
