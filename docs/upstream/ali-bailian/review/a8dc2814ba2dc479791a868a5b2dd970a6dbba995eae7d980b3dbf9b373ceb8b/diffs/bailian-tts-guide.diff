-        curl -X POST https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer \
-        -H "Authorization: Bearer $DASHSCOPE_API_KEY" \
-        -H "Content-Type: application/json" \
